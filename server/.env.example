# Server Environment Variables Configuration
# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# Express Server Port
PORT=5500

# JSON Web Token Secret (replace with a secure random key in production)
JWT_SECRET="replace-with-a-secure-random-secret-key-for-jwt"

# Allowed Client URLs for CORS (comma-separated for multiple origins, e.g. https://sumandangol.com,https://portfolio.vercel.app)
CLIENT_URL="http://localhost:5173,http://localhost:3000"

# Node Environment ('development' | 'production')
NODE_ENV="development"
