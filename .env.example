# Copy this to .env and fill values before running docker-compose
# Database connection for Prisma: note the 'db' hostname is the compose service name
DATABASE_URL="postgresql://postgres:postgres@db:5432/portfolio?schema=public"
# A strong secret for signing JWTs
JWT_SECRET="replace-with-a-strong-secret"
# Server port (the container exposes 5500)
PORT=5500
