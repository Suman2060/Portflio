# ==============================================================================
# Full-Stack Portfolio Application Environment Configuration Template
# ==============================================================================

# Database connection for PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# A strong secret key for signing Admin JWT tokens
JWT_SECRET="replace-with-a-strong-jwt-secret"

# Backend API Server Port
PORT=5500

# Allowed Client Origin(s) for CORS (comma-separated if multiple)
CLIENT_URL="http://localhost:5173,http://localhost:3000"

# Client Frontend API Base URL (used by Vite in client/)
VITE_API_URL="http://localhost:5500/api"

# Node Environment ('development' | 'production')
NODE_ENV="development"
